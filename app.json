{
  "expo": {
    "name": "つみノート",
    "slug": "tsumi-note",
    "scheme": "tsumi-note",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/AppIcon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "dev.hosokawalab.tsuminote",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ja",
        "CFBundleLocalizations": ["ja"],
        "LSApplicationCategoryType": "public.app-category.education"
      },
      "buildNumber": "5"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "locales": {
      "ja": "./locales/ja.json"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "ノートに挿入する画像を選ぶために、写真ライブラリへアクセスします。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6949ff",
          "dark": {
            "backgroundColor": "#6949ff"
          }
        }
      ],
      "expo-apple-authentication",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-web-browser",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
