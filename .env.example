# アプリ(Expo)の環境変数。EXPO_PUBLIC_* はビルドに埋め込まれる公開値のため、秘密情報を入れないこと。
# コピーして `.env` を作る(.env はコミットしない)。

# 認証APIのURL。未設定ならアカウント機能は無効(ゲスト利用のみ)。
# 本番は https 必須。開発のみ http://localhost / プライベートIP を許可する(例: http://192.168.0.10:8787)。
EXPO_PUBLIC_API_URL=

# Google OAuth の iOS クライアントID(例: 1234567890-abc.apps.googleusercontent.com)。未設定なら Google ログインは無効。
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
